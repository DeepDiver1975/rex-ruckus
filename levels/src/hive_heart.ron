        (id: "pod_b", rect: (58.0, 2.0, 62.0, 6.0), floor_z: -0.8, ceil_z: 8.0, floor: "flesh", ceil: "flesh", face: "flesh"),
        (id: "pod_c", rect: (56.0, 13.0, 59.0, 16.0), floor_z: -0.6, ceil_z: 8.0, floor: "flesh", ceil: "flesh", face: "flesh"),
        (id: "pod_d", rect: (44.0, 1.0, 46.5, 3.5), floor_z: -1.0, ceil_z: 8.0, floor: "flesh", ceil: "flesh", face: "flesh"),
        (id: "brood_pool", rect: (48.0, -2.0, 54.0, 3.0), floor_z: -2.4, ceil_z: 8.0, floor: "slime", ceil: "flesh",
