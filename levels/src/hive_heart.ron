// Episode 2, level 7: the finale. Coordinates in metres, x = east, y = north, z = up.
// Setting: below the plant's bore, the heart of the alien hive: organic caverns, egg chambers,
// slime and water pools, glowing pores. The Hive Queen waits in her chamber at the end.
// Route: the bore landing (start west, facing east; the broken casing stub, the shotgun) → the
// burrow tunnel east → the fork (a hive column) → steps down east into the egg nursery (the
// chaingun by the steps, egg pods, a brood pool; entering fires channel 2, a rumble) → the neck
// south → the egg chamber: the Blue key on the egg dais (channel 1: the hive closet in the east
// wall bursts open, awake, and the brood door in the west wall opens on the brood run back to
// the fork, the shortcut) → back through the nursery, the blue membrane door in its north wall →
// the gut → the gut's end: entering fires channel 3, a quake, and a scripted blast blows the
// cracked membrane ahead open → the lake cavern's south shore (the rocket launcher, the
// jetpack; a hive lip walls the shore off from the water but for the dock) → onto the membrane
// raft: the switch on the stalk beside the dock (channel 6) floats it 13.8 m north across the
// lake, and the stalk on the far dock sends it back → the north shore → the pore tunnel west →
// the hatchery (egg clusters, a slime pool): up the brood mound for the Red key (channel 4: a
// quake, the hive closet in the west wall bursts open, awake, and the hatch door in the south
// wall opens on the west run back to the south shore, the shortcut past the lake) → the red door
// north → the neck → the staging chamber (armour, an atom, rockets, pipe bombs, a chaingun, a
// medkit) → east through the lip hall to the lip (channel 5: a quake as the Queen stirs) → the
// 4 m drop into the Queen's chamber (36 x 30 m, 21 m high, four hive mounds for cover, five
// burrow points). She sleeps at the far end facing the lip and wakes when she sees Rex; her
// death ends the episode. The drop is one way: nothing in the chamber climbs back out, and the
// level has no other exit. Steps in the lake's south-east corner climb out of the water.
// Secrets: (1) the nursery's east wall cracks open on a blast (a barrel beside it): the old egg
// cache (atom, armour); (2) a crouch vent (1.3 m) in the burrow tunnel's south wall into a pocket
// (atom, armour, rockets); (3) a jetpack-only ledge at z 4 high in the lake's east wall (atom,
// rockets). Validate warns that the cache's and the ledge's items "cannot be reached from the
// start": a crack-wall stash and a jetpack ledge, by design.
(
    name: "Hive Heart",
    defaults: (floor_z: 0.0, ceil_z: 4.0, floor: "hive", ceil: "hive", wall: "hive"),
    music: Some("hive_heart"),
    player_start: (pos: (3.0, 5.0), angle_deg: 0.0),
    sectors: [
        // ---- The bore landing (16 m: the bore casing above) ----
        (id: "landing", rect: (0.0, 0.0, 12.0, 10.0), holes: [[(7.0, 6.5), (9.0, 6.5), (9.0, 8.5), (7.0, 8.5)]],
         ceil_z: 16.0, floor: "grate", ceil: "pipe", wall: "hive"),
        // The broken end of the drill string, standing in the floor.
        (id: "casing", rect: (7.0, 6.5, 9.0, 8.5), floor_z: 2.5, ceil_z: 16.0, floor: "pipe", ceil: "pipe", face: "pipe"),

        // ---- The burrow tunnel and the fork ----
        (id: "tunnel_a", rect: (12.0, 4.0, 20.0, 8.0), ceil_z: 3.5),
        (id: "tunnel_b", rect: (20.0, 4.0, 28.0, 8.0), ceil_z: 3.0),
        // Secret 2: the crouch vent in the tunnel's south wall, and the pocket behind it.
        (id: "vent", rect: (18.0, 2.5, 19.6, 4.0), ceil_z: 1.3, floor: "hive", ceil: "flesh"),
        (id: "pocket", rect: (15.0, -3.0, 23.0, 2.5), ceil_z: 2.6, ceil: "flesh", secret: true),
        (id: "fork", rect: (28.0, 0.0, 36.0, 12.0), holes: [[(31.0, 5.0), (33.0, 5.0), (33.0, 7.0), (31.0, 7.0)]],
         ceil_z: 5.0),
        (id: "fork_column", rect: (31.0, 5.0, 33.0, 7.0), floor_z: 4.8, ceil_z: 5.0, floor: "flesh", face: "hive"),

        // ---- The egg nursery (10 m) ----
        (id: "nursery", rect: (42.0, -6.0, 66.0, 20.0),
