// Episode level 1. Coordinates in metres, x = east, y = north, z = up.
// Route: rooftop (start, z 12; helipad with a wrecked chopper, 3 sleeping Grunts) → east into the
// stairwell: down the first flight to the landing (shotgun, a breakable lamp) → down the second
// flight (2 Enforcers) → the foot → door south into the street. Alternative: hop the fire escape
// south-east of the roof (ledges z 6 and 3, shells, a Drone) and drop onto the street.
// Street (burning car, newsstand, barrels, Grunts, Slashers, Drones): the grate mid-street fires
// channel 1, opening the two shop fronts on the north side (awake Grunts) → the theater canopy →
// either lobby door → lobby (vending machine, restroom with a toilet, medkit) → stairs up to the
// manager's mezzanine office (red key, a Slasher) → drop back into the lobby → red door in the
// east wall → auditorium: up the entry steps to the rear aisle, down the seating rows (Grunts; a
// balcony wing above on the north side) → front aisle → stage steps → stage (a Slasher) → door
// in the stage's east wall → backstage → exit switch on the east wall.
// Secrets: (1) a crouch vent in the roof's north wall at x 26-30 into the roof hut (armour);
// (2) the scorched alley wall at x 90 behind the barrel cracks open on a blast: stash (atom,
// rockets); (3) a crouch gap in the balcony's north wall into the projection booth (medkit, atom).
(
    name: "Hollywood Meltdown",
    defaults: (floor_z: 0.0, ceil_z: 4.0, floor: "concrete", ceil: "ceiling_tile", wall: "brick"),
    music: Some("hollywood"),
    player_start: (pos: (4.0, 75.0), angle_deg: 0.0),
    sectors: [
        // ---- Rooftop (z 12, open sky) ----
        (id: "roof", poly: [(0.0, 60.5), (24.0, 60.5), (24.0, 60.0), (30.0, 60.0), (30.0, 90.0), (0.0, 90.0)],
         holes: [[(20.08, 78.1), (17.1, 81.08), (12.9, 81.08), (9.92, 78.1), (9.92, 73.9), (12.9, 70.92), (17.1, 70.92), (20.08, 73.9)]],
         floor_z: 12.0, ceil_z: 30.0, floor: "gravel", ceil: "sky", wall: "concrete"),
        (id: "helipad", poly: [(20.08, 78.1), (17.1, 81.08), (12.9, 81.08), (9.92, 78.1), (9.92, 73.9), (12.9, 70.92), (17.1, 70.92), (20.08, 73.9)],
         holes: [[(13.2, 75.0), (16.8, 74.2), (17.6, 76.4), (15.0, 78.2), (13.0, 77.4)]],
         floor_z: 12.3, ceil_z: 30.0, floor: "glowstrip", ceil: "sky", wall: "metal"),
        (id: "heli_wreck", poly: [(13.2, 75.0), (16.8, 74.2), (17.6, 76.4), (15.0, 78.2), (13.0, 77.4)],
         floor_z: 13.6, ceil_z: 30.0, floor: "hull", ceil: "sky", wall: "hull"),
        // A parapet along the roof's south edge, over the street.
        (id: "parapet", rect: (0.0, 60.0, 24.0, 60.5), floor_z: 13.0, ceil_z: 30.0, floor: "concrete", ceil: "sky", wall: "concrete"),
        // Secret 1: a crouch vent in the north wall, into the roof hut.
        (id: "vent", rect: (26.0, 90.0, 32.0, 91.2), floor_z: 12.0, ceil_z: 13.2, floor: "grate", ceil: "metal", wall: "grate"),
        (id: "roof_hut", rect: (31.0, 84.0, 36.0, 90.0), floor_z: 12.0, ceil_z: 15.0, floor: "wood", ceil: "wood", wall: "wood", secret: true),

        // ---- Stairwell: flight 1 (roof → landing), landing, flight 2 (→ foot) ----
