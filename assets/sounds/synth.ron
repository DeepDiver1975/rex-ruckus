// Sound-effect recipes for `rr-tools synth` (crates/tools/src/synth.rs). This file is the source
// of truth; regenerate the WAVs after editing it:
//
//     cargo run -p rr-tools -- synth assets/sounds/synth.ron -o assets/sounds/synth
//
// Each sound mixes its layers and is peak-normalised to -1 dBFS, so `gain` only sets the balance
// between layers. Noise is sample-and-held at 32 x `freq`: from about 700 Hz up it is plain
// white, lower values make it grittier. Loops must keep an integer number of cycles of every
// tonal frequency (and vibrato) over their length, so the cross-fade at the seam stays in phase.
[
    // Pistol: a white-noise crack with a hard punch, a square "snap" diving in pitch and a
    // short low thump for body.
    (name: "pistol", seed: 1, layers: [
        (wave: Noise, freq: 1000.0, sustain: 0.015, decay: 0.12, punch: 1.2, lpf: 5500.0, hpf: 250.0, gain: 0.9),
        (wave: Square, freq: 620.0, slide: -2600.0, sustain: 0.02, decay: 0.08, punch: 0.6, lpf: 6000.0, hpf: 80.0, gain: 0.55),
        (wave: Sine, freq: 150.0, slide: -400.0, sustain: 0.01, decay: 0.1, punch: 0.5, gain: 0.8),
    ]),
    // Shotgun: a fat, slightly gritty blast with brown rumble and a deep thump, then the pump
    // racking back ("chk-chk") as two filtered clicks.
    (name: "shotgun", seed: 2, layers: [
        (wave: Noise, freq: 320.0, sustain: 0.04, decay: 0.32, punch: 1.0, lpf: 3800.0, hpf: 60.0, gain: 1.0),
        (wave: Brown, freq: 900.0, sustain: 0.05, decay: 0.35, punch: 0.6, lpf: 500.0, gain: 0.7),
        (wave: Square, freq: 240.0, slide: -700.0, sustain: 0.02, decay: 0.1, punch: 0.8, lpf: 2500.0, gain: 0.35),
        (wave: Sine, freq: 95.0, slide: -120.0, sustain: 0.01, decay: 0.25, punch: 1.0, gain: 0.9),
        (wave: Noise, freq: 1000.0, sustain: 0.01, decay: 0.03, punch: 1.0, hpf: 1800.0, lpf: 7000.0, gain: 0.8, delay: 0.42),
        (wave: Square, freq: 1100.0, duty: 0.25, decay: 0.025, lpf: 3500.0, gain: 0.25, delay: 0.42),
        (wave: Noise, freq: 1000.0, sustain: 0.01, decay: 0.035, punch: 1.0, hpf: 1200.0, lpf: 6000.0, gain: 0.9, delay: 0.52),
        (wave: Square, freq: 800.0, duty: 0.25, decay: 0.03, lpf: 3000.0, gain: 0.25, delay: 0.52),
    ]),
    // Chaingun: one short, bright, crushed shot; the game retriggers it quickly.
    (name: "chaingun", seed: 3, layers: [
        (wave: Noise, freq: 600.0, sustain: 0.01, decay: 0.07, punch: 1.0, lpf: 6000.0, hpf: 300.0, crush_bits: 6, gain: 0.9),
        (wave: Square, freq: 900.0, slide: -4500.0, sustain: 0.01, decay: 0.04, punch: 0.8, lpf: 5000.0, gain: 0.5),
        (wave: Sine, freq: 170.0, slide: -500.0, decay: 0.06, gain: 0.6),
    ]),
    // Rocket launch: a thump and a rising engine grind under a long, hissing whoosh.
    (name: "rocket_launch", seed: 4, layers: [
        (wave: Sine, freq: 85.0, slide: -60.0, sustain: 0.01, decay: 0.2, punch: 1.0, gain: 0.9),
