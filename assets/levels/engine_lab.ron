        // 32 gallery bay: screen walls, carpet
        (loops: [[134, 132, 133, 135]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 7, ceil_mat: 3, wall_mat: 13),
        // 33 gallery bay: pipe walls and ceiling, grate floor
        (loops: [[136, 134, 135, 137]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 17, ceil_mat: 16, wall_mat: 16),
