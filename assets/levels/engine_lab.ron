// M5b showcase level (not in the episode): every engine feature once. Coordinates in metres,
// x = east, y = north, z = up.
// Route: hall (start; jetpack, shotgun, armour) → north doorway → gag room (a toilet to flush,
// a vending machine with three cans, a pool table; chaingun, medkit) → back through the hall
// → east doorway → west ledge over the slime pit (slime floor 1 m down, a slime stair up to
// the east ledge; the rocket launcher waits on the east ledge, the jetpack flies across) →
// north doorway → infight arena (a Grunt and an Enforcer on one line from the doorway: the
// Enforcer's volleys at the player hit the Grunt, which turns on it) → east: a live electric
// grate → trigger pad (channel 7: a quake, and the collapse floor ahead drops 2 m) → down the
// hole and south through the tunnel (rockets) → open-air boss arena (atom; the boss's death
// ends the level).
// Side trip south of the hall (sliders): the switch beside the south doorway (channel 8) slides
// the sluice gate, a tall block hanging in the corridor, aside into its pocket → landing over a
// second slime pit → the switch by the corridor mouth (channel 9) sends the platform across the
// pit to the far ledge (a medkit), which nothing else reaches; the ledge switch calls it back. A
// stair in the pit's west edge climbs out of the slime.
// Breach (channel 10): the switch on the gag room's west wall rumbles the floor, and half a second
// later a scripted blast in the sealed lounge behind the wall blows its crack wall open → the
// lounge (a secret: an arcade cabinet and a jukebox; pipe bombs). The payphone on the hall's west
// wall tells how many secrets are left on the first call.
// Hive (side trip north of the gag room): through the door in the gag room's north wall → the
// Hive Queen's chamber (18 m square, three pillars for cover, four burrow points). She sleeps
// facing the door and wakes when she sees the player come in; her death (channel 11) opens the
// stash door in the north wall (an atom and rockets). A rocket launcher waits by the door; the
// door is too narrow for her to follow.
// Material gallery (side trip west of the hall, sectors 29-37): a doorway in the hall's west
// wall opens on a 5 m wide corridor of 3 m bays running west, each showing one Aftershock
// material: container, storefront, screen, pipe, rail, hive (with a magma Burn pit, 0.4 m deep,
// in the middle of the bay) and a shallow water pool at the far end.
(
    name: "Engine Lab",
    materials: ["brick", "concrete", "sky", "metal", "tile", "wood", "door", "carpet", "flesh",
                // 9-18: the gallery
                "container", "water", "magma", "hive", "screen", "rail", "storefront", "pipe",
                "grate", "ceiling_tile"],
    vertices: [
        (0.0, 0.0), (12.0, 0.0), (12.0, 3.0), (12.0, 5.0), (12.0, 8.0), (6.0, 8.0), // 0-5   hall
        (4.0, 8.0), (0.0, 8.0),                                                       // 6-7
        (6.0, 9.0), (4.0, 9.0), (0.0, 9.0), (10.0, 9.0), (10.0, 15.0), (0.0, 15.0),   // 8-13  gag room
        (13.0, 3.0), (13.0, 5.0),                                                     // 14-15 pit doorway
        (13.0, 0.0), (15.0, 0.0), (15.0, 8.0), (13.0, 8.0),                           // 16-19 west ledge
        (20.0, 0.0), (20.0, 8.0), (21.0, 0.0), (21.0, 8.0),                           // 20-23 pit, stair
        (25.0, 0.0), (25.0, 8.0), (24.0, 8.0), (22.0, 8.0),                           // 24-27 east ledge
        (24.0, 9.0), (22.0, 9.0),                                                     // 28-29 arena doorway
        (16.0, 9.0), (30.0, 9.0), (30.0, 14.0), (30.0, 16.0), (30.0, 21.0),           // 30-34 arena
        (16.0, 21.0),                                                                 // 35
        (32.0, 14.0), (32.0, 16.0), (33.0, 14.0), (33.0, 16.0),                       // 36-39 grate, pad
        (36.0, 14.0), (36.0, 16.0), (38.0, 14.0), (38.0, 16.0),                       // 40-43 corridor, collapse
        (36.0, 8.0), (38.0, 8.0), (38.0, 12.0),                                       // 44-46 tunnel
        (38.0, -6.0), (56.0, -6.0), (56.0, 12.0),                                     // 47-49 boss arena
        (44.0, -2.0), (44.0, 0.0), (46.0, 0.0), (46.0, -2.0),                         // 50-53 pillar
        (44.0, 6.0), (44.0, 8.0), (46.0, 8.0), (46.0, 6.0),                           // 54-57 pillar
        (8.0, 0.0), (10.0, 0.0),                                                      // 58-59 south doorway
        (8.0, -4.0), (10.0, -4.0), (10.0, -3.0),                                      // 60-62 gate corridor
        (8.0, -1.5), (6.0, -1.5), (6.0, -2.5), (8.0, -2.5),                           // 63-66 gate pocket
        (4.0, -5.0), (5.0, -5.0), (14.0, -5.0), (14.0, -4.0), (11.0, -4.0), (4.0, -4.0), // 67-72 landing
        (4.0, -12.0), (5.0, -12.0), (7.0, -12.0), (11.0, -12.0), (14.0, -12.0),       // 73-77 stair, pit
        (7.5, -8.1), (10.5, -8.1), (10.5, -5.1), (7.5, -5.1),                         // 78-81 platform
        (7.0, -13.0), (11.0, -13.0),                                                  // 82-83 far ledge
        (8.1, -2.4), (9.9, -2.4), (9.9, -1.6), (8.1, -1.6),                           // 84-87 gate
        (0.0, 13.0), (0.0, 11.0), (-0.5, 11.0), (-0.5, 13.0),                         // 88-91 breach
        (-4.5, 9.5), (-0.5, 9.5), (-0.5, 14.5), (-4.5, 14.5),                         // 92-95 lounge
        (6.0, 15.0), (4.0, 15.0), (6.0, 15.5), (4.0, 15.5),                           // 96-99 hive door
        (-4.0, 15.5), (14.0, 15.5), (14.0, 33.5), (-4.0, 33.5),                       // 100-103 hive
        (6.0, 33.5), (4.0, 33.5), (6.0, 34.0), (4.0, 34.0),                           // 104-107 stash door
        (3.0, 34.0), (7.0, 34.0), (7.0, 37.0), (3.0, 37.0),                           // 108-111 stash
        (0.0, 21.0), (0.0, 23.0), (2.0, 23.0), (2.0, 21.0),                           // 112-115 pillar
        (8.0, 21.0), (8.0, 23.0), (10.0, 23.0), (10.0, 21.0),                         // 116-119 pillar
        (4.0, 26.5), (4.0, 28.5), (6.0, 28.5), (6.0, 26.5),                           // 120-123 pillar
        (0.0, 3.5), (0.0, 1.5), (-1.0, 1.5), (-1.0, 3.5),                             // 124-127 gallery door
        (-1.0, 0.0), (-1.0, 5.0), (-4.0, 0.0), (-4.0, 5.0), (-7.0, 0.0), (-7.0, 5.0),   // 128-133 gallery bays
        (-10.0, 0.0), (-10.0, 5.0), (-13.0, 0.0), (-13.0, 5.0), (-16.0, 0.0), (-16.0, 5.0), // 134-139
        (-19.0, 0.0), (-19.0, 5.0), (-22.0, 0.0), (-22.0, 5.0),                       // 140-143
        (-18.5, 1.5), (-16.5, 1.5), (-16.5, 3.5), (-18.5, 3.5),                       // 144-147 magma pit
    ],
    sectors: [
        // 0 hall (start; jetpack, shotgun, armour)
        (loops: [[0, 58, 59, 1, 2, 3, 4, 5, 6, 7, 124, 125]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 1, ceil_mat: 3, wall_mat: 0),
