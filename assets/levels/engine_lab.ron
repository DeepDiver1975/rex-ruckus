        (loops: [[78, 79, 80, 81]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 3, ceil_mat: 3, wall_mat: 3,
         mover: Some((kind: Slide(by: (0.0, -3.8)), channel: Some(9), speed: 1.5))),
        // 22 far ledge (medkit)
        (loops: [[82, 83, 76, 75]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 1, ceil_mat: 3, wall_mat: 0),
