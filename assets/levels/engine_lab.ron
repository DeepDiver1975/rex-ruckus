         floor_mat: 1, ceil_mat: 3, wall_mat: 0,
         hazard: Some((damage: 4, interval: 0.75, kind: Slime))),
        // 21 platform: docked 0.1 m off the landing, slides 3.8 m south to 0.1 m off the far
