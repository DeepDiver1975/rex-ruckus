// M2 test level: every mechanic once. Coordinates in metres, x = east, y = north, z = up.
// Route: hall switch (west wall) opens the closet door → blue key; hall door → corridor →
// red door is locked → ride the lift to the balcony → red key → back down → vault → exit
// switch (needs blue).
(
    name: "Mechanics Lab",
    materials: ["brick", "concrete", "sky", "metal", "tile", "wood", "door"],
    vertices: [
        (0.0, 0.0), (12.0, 0.0), (12.0, 4.0), (12.0, 6.0), (12.0, 10.0),   // 0-4  hall
        (7.0, 10.0), (5.0, 10.0), (0.0, 10.0),                             // 5-7
        (7.0, 10.5), (5.0, 10.5),                                          // 8-9  door D1
        (4.0, 10.5), (8.0, 10.5), (8.0, 12.0), (8.0, 14.0), (8.0, 18.0),   // 10-14 corridor
        (7.0, 18.0), (5.0, 18.0), (4.0, 18.0),                             // 15-17
        (10.0, 12.0), (10.0, 14.0),                                        // 18-19 lift
        (10.0, 11.0), (14.0, 11.0), (14.0, 15.0), (10.0, 15.0),            // 20-23 balcony
        (7.0, 18.5), (5.0, 18.5),                                          // 24-25 door D2
        (3.0, 18.5), (9.0, 18.5), (9.0, 24.0), (3.0, 24.0),                // 26-29 vault
        (12.5, 4.0), (12.5, 6.0),                                          // 30-31 door D3
        (12.5, 3.0), (16.0, 3.0), (16.0, 7.0), (12.5, 7.0),                // 32-35 closet
        (0.0, 5.5), (0.0, 4.5), (6.5, 24.0), (5.5, 24.0),                  // 36-39 switch wall ends
    ],
    sectors: [
        // 0 hall
        (loops: [[0, 1, 2, 3, 4, 5, 6, 7, 36, 37]], floor_z: 0.0, ceil_z: 4.0, floor_mat: 1, ceil_mat: 3, wall_mat: 0),
        // 1 door D1 (hall → corridor), closes again after 4 s
        (loops: [[6, 5, 8, 9]], floor_z: 0.0, ceil_z: 3.0, floor_mat: 3, ceil_mat: 3, wall_mat: 3,
         face_mat: Some(6), mover: Some((kind: Door, auto_return: Some(4.0)))),
        // 2 corridor
        (loops: [[10, 9, 8, 11, 12, 13, 14, 15, 16, 17]], floor_z: 0.0, ceil_z: 5.0, floor_mat: 4, ceil_mat: 3, wall_mat: 0),
        // 3 lift up to the balcony
        (loops: [[12, 18, 19, 13]], floor_z: 0.0, ceil_z: 5.0, floor_mat: 3, ceil_mat: 3, wall_mat: 3,
         face_mat: Some(3), mover: Some((kind: Lift(to: 2.4), speed: 2.0))),
        // 4 balcony (red key)
        (loops: [[20, 21, 22, 23, 19, 18]], floor_z: 2.4, ceil_z: 5.0, floor_mat: 4, ceil_mat: 3, wall_mat: 0),
        // 5 door D2 (corridor → vault), red lock
        (loops: [[16, 15, 24, 25]], floor_z: 0.0, ceil_z: 3.0, floor_mat: 3, ceil_mat: 3, wall_mat: 3,
         face_mat: Some(6), mover: Some((kind: Door, lock: Some(Red)))),
        // 6 vault (exit switch on the north wall)
        (loops: [[26, 25, 24, 27, 28, 38, 39, 29]], floor_z: 0.0, ceil_z: 4.5, floor_mat: 4, ceil_mat: 3, wall_mat: 5),
        // 7 door D3 (hall → closet), opened by the hall switch on channel 1
        (loops: [[2, 30, 31, 3]], floor_z: 0.0, ceil_z: 3.0, floor_mat: 3, ceil_mat: 3, wall_mat: 3,
         face_mat: Some(6), mover: Some((kind: Door, channel: Some(1)))),
        // 8 closet (blue key)
        (loops: [[32, 33, 34, 35, 31, 30]], floor_z: 0.0, ceil_z: 3.5, floor_mat: 1, ceil_mat: 3, wall_mat: 5),
    ],
    switches: [
        (wall: (36, 37), action: Channel(1)),
        (wall: (38, 39), action: Exit, key: Some(Blue)),
    ],
    items: [
        (kind: Key(Red), pos: (12.0, 13.0)),
        (kind: Key(Blue), pos: (14.5, 5.0)),
    ],
    player_start: (pos: (6.0, 3.0), angle_deg: 90.0),
    lights: [
        (pos: (6.0, 5.0, 3.5), color: (1.0, 0.9, 0.75), intensity: 500000.0, range: 16.0),
        (pos: (6.0, 14.0, 4.5), color: (0.7, 0.85, 1.0), intensity: 300000.0, range: 12.0),
        (pos: (12.0, 13.0, 4.5), color: (1.0, 0.5, 0.4), intensity: 300000.0, range: 10.0),
        (pos: (14.0, 5.0, 3.0), color: (0.5, 0.6, 1.0), intensity: 200000.0, range: 8.0),
        (pos: (6.0, 21.0, 4.0), color: (1.0, 0.85, 0.4), intensity: 400000.0, range: 12.0),
    ],
)
