        attack: Hitscan(damage: 5, pellets: 6, spread_deg: 7.0),
        // The Bruiser's arm-cannon muzzle in its Attack pose (models.ron `tip`, the `Muzzle`
        // bone): 0.33 to the right, 1.47 up, 0.83 ahead.
        muzzle: (0.83, -0.33, 1.47),
        pain_chance: 0.25, pain_time: 0.3, pain_cooldown: 1.0, death_time: 0.9, strafe: true,
    ),
    (
        kind: Slasher,
        health: 45, radius: 0.4, height: 1.5, speed: 7.5,
        sight_range: 25.0, fov_deg: 140.0, reaction: 0.25,
        attack_range: 1.6, attack_refire: 0.9, aim_error_deg: 0.0,
        attack: Melee(damage: 18, lunge_speed: 12.0),
        // The Gnasher's right claw tip at the end of its Attack rake (models.ron `tip`):
        // 0.35 to the right, 1.01 up, 0.98 ahead.
        muzzle: (0.98, -0.35, 1.01),
        pain_chance: 0.35, pain_time: 0.25, pain_cooldown: 0.8, death_time: 0.7, strafe: false,
    ),
    (
        kind: Drone,
        health: 25, radius: 0.4, height: 0.6, speed: 6.0,
        sight_range: 30.0, fov_deg: 120.0, reaction: 0.4,
        attack_range: 18.0, attack_refire: 1.1, aim_error_deg: 3.0,
        attack: Bolts(
            proj: (speed: 18.0, damage: 6, radius: 0.12, life: 4.0),
            burst: 1, burst_gap: 0.0,
        ),
        locomotion: Fly(hover: 2.5, swoop: true),
        // The Peeper's gun muzzle under the eye in its Attack pose (models.ron `tip`, the
