// Enemy tuning. Starting values, to be adjusted in playtests.
// `muzzle` is (forward, side, up) in metres from the feet, side positive to the actor's left.
[
    (
        kind: Grunt,
        health: 30, radius: 0.35, height: 1.75, speed: 3.5,
        sight_range: 30.0, fov_deg: 120.0, reaction: 0.4,
        attack_range: 20.0, attack_refire: 1.6, aim_error_deg: 3.0,
        attack: Bolts(
            proj: (speed: 15.0, damage: 8, radius: 0.12, life: 4.0),
            burst: 2, burst_gap: 0.25,
        ),
        // The Goon's hand-cannon muzzle in its Attack pose (models.ron `tip`, the `Muzzle` bone):
        // 0.31 to the right, 1.49 up, 1.10 ahead.
        muzzle: (1.10, -0.31, 1.49),
        pain_chance: 0.5, pain_time: 0.35, pain_cooldown: 0.8, death_time: 0.8, strafe: true,
    ),
    (
        kind: Enforcer,
        health: 70, radius: 0.4, height: 1.85, speed: 3.0,
