        muzzle: (0.40, 0.0, 0.07),
        pain_chance: 0.4, pain_time: 0.25, pain_cooldown: 0.8, death_time: 0.6, strafe: false,
    ),
    (
        kind: Barrel,
        health: 15, radius: 0.4, height: 1.0, speed: 0.0,
        sight_range: 0.0, fov_deg: 360.0, reaction: 0.0,
        attack_range: 0.0, attack_refire: 0.0, aim_error_deg: 0.0,
        attack: None,
        locomotion: Static,
        muzzle: (0.0, 0.0, 0.5),
        pain_chance: 0.0, pain_time: 0.0, death_time: 0.1, strafe: false,
        death_splash: Some((radius: 4.0, damage: 70, self_scale: 1.0)),
        death_fuse: 0.15,
    ),
    (
        kind: Boss,
        health: 600, radius: 1.3, height: 3.0, speed: 2.2,
        sight_range: 40.0, fov_deg: 140.0, reaction: 0.8,
        attack_range: 30.0, attack_refire: 2.0, aim_error_deg: 2.5,
